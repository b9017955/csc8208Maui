<?xml version="1.0" encoding="utf-8" ?>
<Shell 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
    android:TabbedPage.ToolbarPlacement="Bottom"
    
    x:Class="csc8208Maui.Views.Verifier.VerifierLandingPage"
    xmlns:viewmodel="clr-namespace:csc8208Maui.ViewModels"
    x:DataType="viewmodel:VerifierViewModel"
    xmlns:local="clr-namespace:csc8208Maui;assembly=csc8208Maui"
    xmlns:verifier="clr-namespace:csc8208Maui.Views.Verifier"
    Style="{StaticResource TabStyle}"
    Shell.FlyoutBehavior="Disabled"
    >
    <TabBar>
        <Tab>
            
            <ShellContent Title="Home" ContentTemplate="{DataTemplate verifier:VerifierHome}" Route="VerifierHome}"/>
            
            <ShellContent Title="Settings" ContentTemplate="{DataTemplate verifier:VerifierSettingsPage}" Route="VerifierSettingsPage"/>
            
        </Tab>
    </TabBar>
</Shell>